<%- include("partials/header", { title, showSearch: false }) %>
<main class="auth-shell">
  <section class="auth-card">
    <h1>Redefinir senha</h1>
    <p class="muted">
      Conta: <strong><%= account.display_name %></strong><br>
      @<%= account.username %> · <%= account.email %>
    </p>

    <% if (errors.length) { %>
      <div class="form-errors"><% for (const error of errors) { %><div><%= error %></div><% } %></div>
    <% } %>

    <form method="post" class="stack-form">
      <input type="hidden" name="_csrf" value="<%= csrf %>">

      <label>Nova senha
        <input type="password" name="new_password" minlength="12" maxlength="128" required autocomplete="new-password">
        <span class="field-hint">Use pelo menos 12 caracteres, com uma letra e um número.</span>
      </label>

      <label>Confirmar nova senha
        <input type="password" name="confirm_password" minlength="12" maxlength="128" required autocomplete="new-password">
      </label>

      <button class="primary" type="submit">Redefinir senha</button>
    </form>

    <div class="notice account-security-note">Todas as sessões existentes desta conta serão encerradas.</div>
    <a href="/usuarios">← Voltar aos usuários</a>
  </section>
</main>
<%- include("partials/footer") %>
