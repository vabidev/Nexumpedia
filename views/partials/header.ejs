<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title><%= title === "Nexumpedia" ? "Nexumpedia — Conhecimento em conexão" : title + " — Nexumpedia" %></title>
  <meta name="description" content="<%= seo?.description || "Nexumpedia, uma enciclopédia digital de conteúdo editorial revisado." %>">
  <meta name="robots" content="<%= seo?.robots || "noindex,nofollow" %>">
  <% if (seo?.canonical) { %><link rel="canonical" href="<%= seo.canonical %>"><% } %>
  <meta property="og:site_name" content="Nexumpedia">
  <meta property="og:title" content="<%= title === "Nexumpedia" ? "Nexumpedia — Conhecimento em conexão" : title + " — Nexumpedia" %>">
  <meta property="og:description" content="<%= seo?.description || "Nexumpedia, uma enciclopédia digital de conteúdo editorial revisado." %>">
  <meta property="og:type" content="<%= seo?.type || "website" %>">
  <% if (seo?.canonical) { %><meta property="og:url" content="<%= seo.canonical %>"><% } %>
  <link rel="icon" href="/assets/img/nexumpedia-mark.svg">
  <link rel="stylesheet" href="/assets/css/nexumpedia.css">
  <% if (seo?.jsonLd) { %>
    <script type="application/ld+json" nonce="<%= cspNonce %>"><%- JSON.stringify(seo.jsonLd).replace(/</g, "\\u003c") %></script>
  <% } %>
</head>
<body>
<a class="skip-link" href="#conteudo-principal">Pular para o conteúdo</a>
<header class="topbar">
  <a class="brand" href="/" aria-label="Nexumpedia, página principal">
    <img src="/assets/img/nexumpedia-mark.svg" alt="">
    <span>
      <span class="brand-name">Nexumpedia</span>
      <span class="brand-tagline">CONHECIMENTO EM CONEXÃO</span>
    </span>
  </a>

  <% if (typeof showSearch === "undefined" || showSearch) { %>
    <form class="search" role="search" method="get" action="<%= typeof searchAction !== "undefined" ? searchAction : "/" %>">
      <input type="search" name="q" aria-label="Pesquisar na Nexumpedia" placeholder="Pesquisar na Nexumpedia" value="<%= typeof q !== "undefined" ? q : "" %>">
      <button>Pesquisar</button>
    </form>
  <% } else { %>
    <div></div>
  <% } %>

  <nav class="usernav" aria-label="Conta">
    <% if (user) { %>
      <a class="hide-md" href="/painel"><%= user.display_name %></a>
      <a class="hide-md" href="/conta">Conta</a>
      <form method="post" action="/logout" class="inline-form">
        <input type="hidden" name="_csrf" value="<%= csrf %>">
        <button class="link-button" type="submit">Sair</button>
      </form>
    <% } %>
    <button class="icon-btn" type="button" data-theme-toggle aria-label="Alternar tema" aria-pressed="false">◐</button>
    <button class="icon-btn mobile-menu" type="button" data-menu-toggle aria-label="Abrir menu" aria-expanded="false" aria-controls="navegacao-lateral">☰</button>
  </nav>
</header>

<% for (const flash of flashes || []) { %>
  <div class="flash <%= flash.type === "error" ? "error" : flash.type === "success" ? "success" : "info" %>" role="status" aria-live="polite"><%= flash.message %></div>
<% } %>
