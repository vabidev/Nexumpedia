<%- include("partials/header", { title }) %>
<div class="page">
  <%- include("partials/sidebar") %>

  <main id="conteudo-principal" class="article">
    <header class="article-header">
      <div class="article-kicker">Da Nexumpedia, a enciclopédia de conhecimento em conexão.</div>
      <h1><%= article.title %></h1>
      <div class="article-tabs">
        <div class="tabs">
          <a class="tab active" href="/artigo/<%= encodeURIComponent(article.slug) %>">Artigo</a>
          <a class="tab" href="/historico/<%= encodeURIComponent(article.slug) %>">Histórico</a>
        </div>
        <div class="article-tools">
          <% if (editable) { %><a href="/editor?id=<%= article.id %>">Editar</a><% } %>
        </div>
      </div>
    </header>

    <% if (article.status !== "published") { %>
      <div class="notice"><strong><%= statusLabel(article.status) %>.</strong> Esta versão só está visível porque você possui acesso editorial.</div>
    <% } %>

    <% if (infobox) { %>
      <aside class="infobox">
        <div class="infobox-title"><%= infobox.title || article.title %></div>
        <% if (infobox.media_id) { %>
          <div class="infobox-media">
            <img src="/media/<%= infobox.media_id %>" alt="<%= infobox.media_alt || infobox.caption || infobox.media_name || article.title %>">
            <% if (infobox.caption) { %><div class="infobox-caption"><%= infobox.caption %></div><% } %>
          </div>
        <% } %>
        <% if (infobox.fields.length) { %>
          <dl>
            <% for (const field of infobox.fields) { %>
              <dt><%= field.label %></dt><dd><%= field.value %></dd>
            <% } %>
          </dl>
        <% } %>
      </aside>
    <% } %>

    <% if (article.summary) { %><p class="lead"><%= article.summary %></p><% } %>

    <% if (headings.length || references.length) { %>
      <nav class="inline-toc" aria-label="Índice">
        <strong>Índice</strong>
        <ol>
          <% for (const heading of headings) { %>
            <li><a href="#<%= heading.id %>"><%= heading.title %></a></li>
          <% } %>
          <% if (references.length) { %><li><a href="#referencias">Referências</a></li><% } %>
        </ol>
      </nav>
    <% } %>

    <div class="article-content"><%- renderedContent %></div>

    <% if (references.length) { %>
      <section class="references-section">
        <h2 id="referencias">Referências</h2>
        <ol class="references-list">
          <% for (let index = 0; index < references.length; index += 1) { const ref = references[index]; %>
            <li id="ref-<%= ref.citation_key %>">
              <% if (ref.author) { %><span class="reference-author"><%= ref.author %>.</span> <% } %>
              <% if (ref.url) { %>
                <a href="<%= ref.url %>" rel="noopener noreferrer"><cite><%= ref.title %></cite></a>.
              <% } else { %>
                <cite><%= ref.title %></cite>.
              <% } %>
              <% if (ref.publisher) { %> <%= ref.publisher %>.<% } %>
              <% if (ref.published_date) { %> <%= ref.published_date %>.<% } %>
              <% if (ref.note) { %> <%= ref.note %>.<% } %>
              <% if (ref.accessed_date) { %> Acesso em <%= ref.accessed_date %>.<% } %>
              <a class="reference-backlink" href="#cite-<%= ref.citation_key %>-1" aria-label="Voltar para a primeira citação <%= index + 1 %>">↑</a>
            </li>
          <% } %>
        </ol>
      </section>
    <% } %>

    <% if (categories.length) { %>
      <nav class="article-categories" aria-label="Categorias">
        <span>Categorias:</span>
        <% for (const category of categories) { %>
          <a href="/categoria/<%= encodeURIComponent(category.slug) %>"><%= category.name %></a>
        <% } %>
      </nav>
    <% } %>

    <footer class="footer">
      <% if (article.published_at) { %>Publicado em <%= formatDate(article.published_at) %> · <% } %>
      última atualização em <%= formatDate(article.updated_at) %>.
      Autor inicial: <%= article.author_name %>.
    </footer>
  </main>

  <aside class="toc-side" aria-label="Nesta página">
    <div class="nav-title">Nesta página</div>
    <% for (const heading of headings) { %><a href="#<%= heading.id %>"><%= heading.title %></a><% } %>
    <% if (references.length) { %><a href="#referencias">Referências</a><% } %>
  </aside>
</div>
<%- include("partials/footer") %>
