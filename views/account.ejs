<%- include("partials/header", { title, showSearch: false }) %>
<main id="conteudo-principal" class="auth-shell">
  <section class="auth-card">
    <h1>Minha conta</h1>
    <p class="muted"><strong><%= user.display_name %></strong> · @<%= user.username %> · <%= user.email %></p>

    <% if (errors.length) { %>
      <div class="form-errors"><% for (const error of errors) { %><div><%= error %></div><% } %></div>
    <% } %>

    <div class="account-access-block">
      <strong>URL privada de acesso</strong>
      <p class="muted">Sua conta usa uma rota particular para abrir a tela de login. O endereço não é exibido aqui porque apenas o hash é armazenado.</p>
      <a class="secondary" href="/conta/acesso">Alterar URL privada</a>
    </div>

    <form method="post" action="/conta/senha" class="stack-form">
      <input type="hidden" name="_csrf" value="<%= csrf %>">

      <label>Senha atual
        <input type="password" name="current_password" required autocomplete="current-password">
      </label>

      <label>Nova senha
        <input type="password" name="new_password" minlength="12" maxlength="128" required autocomplete="new-password">
        <span class="field-hint">Use pelo menos 12 caracteres, com uma letra e um número.</span>
      </label>

      <label>Confirmar nova senha
        <input type="password" name="confirm_password" minlength="12" maxlength="128" required autocomplete="new-password">
      </label>

      <button class="primary" type="submit">Alterar senha</button>
    </form>

    <p class="meta account-security-note">Ao trocar a senha, todas as sessões anteriores são encerradas; esta sessão é renovada com segurança.</p>
    <a href="/painel">← Voltar ao painel</a>
  </section>
</main>
<%- include("partials/footer") %>
