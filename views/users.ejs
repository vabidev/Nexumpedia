<%- include("partials/header", { title, showSearch: false }) %>
<main id="conteudo-principal" class="admin-shell">
  <div class="admin-header">
    <div><div class="meta">Administração</div><h1>Usuários</h1></div>
    <div class="button-row">
      <form method="post" action="/admin/backup">
        <input type="hidden" name="_csrf" value="<%= csrf %>">
        <button class="secondary" type="submit">Baixar backup</button>
      </form>
      <a class="secondary" href="/painel">← Painel</a>
    </div>
  </div>

  <% if (errors.length) { %>
    <div class="form-errors"><% for (const error of errors) { %><div><%= error %></div><% } %></div>
  <% } %>

  <div class="notice backup-warning"><strong>Backup administrativo:</strong> o arquivo inclui conteúdo, mídia e hashes de senha para possibilitar restauração. Guarde-o em local privado.</div>

  <div class="settings-grid">
    <section class="card">
      <div class="card-title">Adicionar colaborador</div>
      <div class="card-body">
        <form method="post" class="stack-form">
          <input type="hidden" name="_csrf" value="<%= csrf %>">
          <input type="hidden" name="action" value="create">
          <label>Usuário<input name="username" required value="<%= values.username || "" %>"></label>
          <label>Nome de exibição<input name="display_name" required value="<%= values.display_name || "" %>"></label>
          <label>E-mail<input type="email" name="email" required value="<%= values.email || "" %>"></label>
          <label>Senha inicial<input type="password" name="password" minlength="12" maxlength="128" required><span class="field-hint">12+ caracteres, com letra e número.</span></label>
          <label>Papel
            <select name="role">
              <option value="collaborator" <%= values.role === "admin" ? "" : "selected" %>>Colaborador</option>
              <option value="admin" <%= values.role === "admin" ? "selected" : "" %>>Administrador</option>
            </select>
          </label>
          <button class="primary">Criar conta</button>
        </form>
      </div>
    </section>

    <section class="card">
      <div class="card-title">Contas cadastradas</div>
      <div class="card-body no-pad">
        <div class="table-wrap borderless">
          <table>
            <thead><tr><th>Nome</th><th>Papel</th><th>Estado</th><th>Acesso</th><th></th></tr></thead>
            <tbody>
              <% for (const account of users) { %>
                <tr>
                  <td><strong><%= account.display_name %></strong><br><span class="meta">@<%= account.username %> · <%= account.email %></span></td>
                  <td><%= account.role === "admin" ? "Administrador" : "Colaborador" %></td>
                  <td><span class="badge <%= account.active ? "good" : "" %>"><%= account.active ? "Ativo" : "Desativado" %></span></td>
                  <td><span class="badge <%= account.login_path_configured ? "good" : "" %>"><%= account.login_path_configured ? "URL privada" : "Primeiro acesso" %></span></td>
                  <td>
                    <% if (Number(account.id) !== Number(user.id)) { %>
                      <form method="post" class="inline-form">
                        <input type="hidden" name="_csrf" value="<%= csrf %>">
                        <input type="hidden" name="action" value="toggle">
                        <input type="hidden" name="user_id" value="<%= account.id %>">
                        <button class="link-button"><%= account.active ? "Desativar" : "Ativar" %></button>
                      </form>
                      · <a href="/usuarios/<%= account.id %>/senha">Redefinir senha</a>
                      <% if (account.login_path_configured) { %>
                        · <form method="post" class="inline-form">
                          <input type="hidden" name="_csrf" value="<%= csrf %>">
                          <input type="hidden" name="action" value="reset_login_path">
                          <input type="hidden" name="user_id" value="<%= account.id %>">
                          <button class="link-button danger-text" type="submit">Resetar URL privada</button>
                        </form>
                      <% } %>
                    <% } %>
                  </td>
                </tr>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>
    </section>
  </div>
</main>
<%- include("partials/footer") %>
