<%- include("partials/header", { title, showSearch: false }) %>
<main class="compare-shell">
  <div class="editor-topline">
    <div>
      <div class="meta">Comparação de histórico</div>
      <h1><%= article.title %></h1>
      <p>Comparando a versão <strong>#<%= from.version_no %></strong> com a versão <strong>#<%= to.version_no %></strong>.</p>
    </div>
    <a class="secondary" href="/historico/<%= encodeURIComponent(article.slug) %>">← Histórico</a>
  </div>

  <div class="diff-legend">
    <span><i class="diff-chip removed"></i> Removido</span>
    <span><i class="diff-chip added"></i> Adicionado</span>
    <span><i class="diff-chip same"></i> Sem alteração</span>
  </div>

  <section class="diff-section">
    <h2>Título</h2>
    <div class="diff-block">
      <% for (const block of titleDiff) { %><pre class="diff-line <%= block.type %>"><%= block.text %></pre><% } %>
    </div>
  </section>

  <section class="diff-section">
    <h2>Resumo</h2>
    <div class="diff-block">
      <% for (const block of summaryDiff) { %><pre class="diff-line <%= block.type %>"><%= block.text %></pre><% } %>
    </div>
  </section>

  <section class="diff-section">
    <h2>Categorias</h2>
    <div class="diff-block">
      <% for (const block of categoriesDiff) { %><pre class="diff-line <%= block.type %>"><%= block.text || "—" %></pre><% } %>
    </div>
  </section>

  <section class="diff-section">
    <h2>Conteúdo</h2>
    <div class="diff-block large">
      <% for (const block of contentDiff) { %><pre class="diff-line <%= block.type %>"><%= block.text %></pre><% } %>
    </div>
  </section>

  <div class="compare-structured">
    <section class="card">
      <div class="card-title">Fontes</div>
      <div class="card-body">
        <p><strong>#<%= from.version_no %>:</strong> <%= Array.isArray(from.references_snapshot) ? from.references_snapshot.length : 0 %></p>
        <p><strong>#<%= to.version_no %>:</strong> <%= Array.isArray(to.references_snapshot) ? to.references_snapshot.length : 0 %></p>
      </div>
    </section>
    <section class="card">
      <div class="card-title">Infobox</div>
      <div class="card-body">
        <p><strong>#<%= from.version_no %>:</strong> <%= from.infobox_snapshot && Object.keys(from.infobox_snapshot).length ? "presente" : "não usada" %></p>
        <p><strong>#<%= to.version_no %>:</strong> <%= to.infobox_snapshot && Object.keys(to.infobox_snapshot).length ? "presente" : "não usada" %></p>
      </div>
    </section>
  </div>
</main>
<%- include("partials/footer") %>
