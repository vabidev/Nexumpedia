<%- include("partials/header", { title, showSearch: false }) %>
<main class="editor-shell">
  <div class="editor-topline">
    <div>
      <div class="meta">Área editorial</div>
      <h1><%= article?.id ? "Editar artigo" : "Novo artigo" %></h1>
    </div>
    <div class="button-row">
      <a class="secondary" href="/painel">← Painel</a>
      <% if (article?.slug) { %><a class="secondary" href="/artigo/<%= encodeURIComponent(article.slug) %>">Visualizar</a><% } %>
    </div>
  </div>

  <% if (article?.status) { %>
    <div class="notice">
      Estado atual: <strong><%= statusLabel(article.status) %></strong>.
      <% if (user.role !== "admin") { %> A publicação final depende de um administrador.<% } %>
    </div>
  <% } %>

  <% if (errors.length) { %>
    <div class="form-errors"><% for (const error of errors) { %><div><%= error %></div><% } %></div>
  <% } %>

  <form method="post" class="editor-form">
    <input type="hidden" name="_csrf" value="<%= csrf %>">
    <input type="hidden" name="id" value="<%= article?.id || "" %>">

    <label>Título
      <input name="title" required maxlength="180" value="<%= article?.title || "" %>">
    </label>

    <label>Resumo
      <textarea name="summary" rows="3" maxlength="500" placeholder="Uma descrição curta do artigo."><%= article?.summary || "" %></textarea>
    </label>

    <label>Categorias
      <input name="categories" maxlength="500" value="<%= categories || "" %>" placeholder="Ex.: Ciência, Tecnologia, História">
      <span class="field-hint">Separe por vírgulas. Até 8 categorias por artigo.</span>
    </label>

    <section class="infobox-editor">
      <div class="reference-editor-head">
        <div>
          <h2>Infobox</h2>
          <p class="meta">Opcional. Use para resumir dados importantes ao lado do artigo.</p>
        </div>
        <button class="secondary" type="button" data-add-infobox-field>+ Adicionar campo</button>
      </div>

      <div class="infobox-editor-meta">
        <label>Título da infobox
          <input name="infobox_title" maxlength="160" value="<%= infobox?.title || "" %>" placeholder="<%= article?.title || "Título da infobox" %>">
        </label>
        <label>Imagem
          <select name="infobox_media_id">
            <option value="">Sem imagem</option>
            <% for (const item of media || []) { %>
              <option value="<%= item.id %>" <%= Number(infobox?.media_id) === Number(item.id) ? "selected" : "" %>>
                <%= item.alt_text || item.original_name %>
              </option>
            <% } %>
          </select>
        </label>
        <label class="infobox-caption-field">Legenda
          <input name="infobox_caption" maxlength="240" value="<%= infobox?.caption || "" %>" placeholder="Legenda opcional da imagem">
        </label>
      </div>

      <div class="infobox-fields-editor" data-infobox-field-list>
        <% for (const field of infobox?.fields || []) { %>
          <div class="infobox-field-row" data-infobox-field-row>
            <label>Campo
              <input name="infobox_label" maxlength="80" required value="<%= field.label || "" %>" placeholder="Ex.: Fundação">
            </label>
            <label>Valor
              <input name="infobox_value" maxlength="500" required value="<%= field.value || "" %>" placeholder="Ex.: 2026">
            </label>
            <button class="link-button danger-text" type="button" data-remove-infobox-field>Remover</button>
          </div>
        <% } %>
      </div>

      <template id="infobox-field-template">
        <div class="infobox-field-row" data-infobox-field-row>
          <label>Campo
            <input name="infobox_label" maxlength="80" required placeholder="Ex.: Fundação">
          </label>
          <label>Valor
            <input name="infobox_value" maxlength="500" required placeholder="Ex.: 2026">
          </label>
          <button class="link-button danger-text" type="button" data-remove-infobox-field>Remover</button>
        </div>
      </template>
    </section>

    <div class="editor-grid">
      <label>Conteúdo
        <textarea class="article-editor" name="content" rows="26" required placeholder="Escreva o artigo aqui..."><%= article?.content || "" %></textarea>
      </label>

      <aside class="editor-help">
        <h3>Formatação</h3>
        <code>## Seção</code>
        <code>### Subseção</code>
        <code>**negrito**</code>
        <code>*itálico*</code>
        <code>- item de lista</code>
        <code>[link](https://...)</code>
        <code>[^fonte1]</code>
        <p><strong>Citação:</strong> cadastre a fonte abaixo e use a chave entre <code>[^ ]</code> no ponto do texto que precisa da nota.</p>
        <p>Imagens enviadas na <a href="/midia" target="_blank">biblioteca de mídia</a> fornecem um código pronto para colar no artigo.</p>
      </aside>
    </div>

    <section class="reference-editor">
      <div class="reference-editor-head">
        <div>
          <h2>Fontes e referências</h2>
          <p class="meta">Cadastre a fonte e use sua chave no texto, por exemplo <code>[^ibge2026]</code>.</p>
        </div>
        <button class="secondary" type="button" data-add-reference>+ Adicionar fonte</button>
      </div>

      <div data-reference-list>
        <% for (const ref of references || []) { %>
          <div class="reference-row" data-reference-row>
            <div class="reference-row-head">
              <strong>Referência</strong>
              <div class="button-row">
                <button class="link-button" type="button" data-insert-citation>Inserir citação</button>
                <button class="link-button danger-text" type="button" data-remove-reference>Remover</button>
              </div>
            </div>
            <div class="reference-fields">
              <label>Chave
                <input name="ref_key" maxlength="40" required value="<%= ref.citation_key || "" %>" placeholder="ibge2026" data-reference-key>
              </label>
              <label class="reference-title-field">Título
                <input name="ref_title" maxlength="240" required value="<%= ref.title || "" %>" placeholder="Título da publicação">
              </label>
              <label>Autor
                <input name="ref_author" maxlength="160" value="<%= ref.author || "" %>" placeholder="Autor ou instituição">
              </label>
              <label>Publicação
                <input name="ref_publisher" maxlength="160" value="<%= ref.publisher || "" %>" placeholder="Editora, jornal, órgão...">
              </label>
              <label class="reference-url-field">URL
                <input type="url" name="ref_url" value="<%= ref.url || "" %>" placeholder="https://...">
              </label>
              <label>Data da publicação
                <input type="date" name="ref_published_date" value="<%= ref.published_date || "" %>">
              </label>
              <label>Data de acesso
                <input type="date" name="ref_accessed_date" value="<%= ref.accessed_date || "" %>">
              </label>
              <label class="reference-note-field">Observação
                <input name="ref_note" maxlength="300" value="<%= ref.note || "" %>" placeholder="Página, edição, capítulo ou outra observação">
              </label>
            </div>
          </div>
        <% } %>
      </div>

      <template id="reference-row-template">
        <div class="reference-row" data-reference-row>
          <div class="reference-row-head">
            <strong>Referência</strong>
            <div class="button-row">
              <button class="link-button" type="button" data-insert-citation>Inserir citação</button>
              <button class="link-button danger-text" type="button" data-remove-reference>Remover</button>
            </div>
          </div>
          <div class="reference-fields">
            <label>Chave<input name="ref_key" maxlength="40" required placeholder="fonte1" data-reference-key></label>
            <label class="reference-title-field">Título<input name="ref_title" maxlength="240" required placeholder="Título da publicação"></label>
            <label>Autor<input name="ref_author" maxlength="160" placeholder="Autor ou instituição"></label>
            <label>Publicação<input name="ref_publisher" maxlength="160" placeholder="Editora, jornal, órgão..."></label>
            <label class="reference-url-field">URL<input type="url" name="ref_url" placeholder="https://..."></label>
            <label>Data da publicação<input type="date" name="ref_published_date"></label>
            <label>Data de acesso<input type="date" name="ref_accessed_date"></label>
            <label class="reference-note-field">Observação<input name="ref_note" maxlength="300" placeholder="Página, edição, capítulo ou outra observação"></label>
          </div>
        </div>
      </template>
    </section>

    <div class="editor-actions">
      <button class="secondary" type="submit" formaction="/editor/preview" formtarget="_blank">Pré-visualizar</button>
      <button class="secondary" type="submit" name="action" value="save">Salvar rascunho</button>
      <button class="secondary" type="submit" name="action" value="review">Enviar para revisão</button>
      <% if (user.role === "admin") { %>
        <button class="primary" type="submit" name="action" value="publish">Publicar</button>
        <% if (article?.id) { %><button class="danger" type="submit" name="action" value="archive">Arquivar</button><% } %>
      <% } %>
    </div>
  </form>
</main>
<%- include("partials/footer") %>
