<%- include("partials/header", { title, showSearch: false }) %>
<main id="conteudo-principal" class="auth-shell">
  <section class="auth-card">
    <div class="auth-logo" aria-hidden="true"><%- include("partials/brand-mark") %></div>
    <h1>Instalar a Nexumpedia</h1>
    <p class="muted">Crie a primeira conta. Ela será a administradora do projeto e poderá adicionar os demais colaboradores.</p>

    <% if (errors.length) { %>
      <div class="form-errors">
        <% for (const error of errors) { %><div><%= error %></div><% } %>
      </div>
    <% } %>

    <form method="post" class="stack-form" novalidate>
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <% if (requireInstallKey) { %>
        <label>Chave de instalação
          <input type="password" name="install_key" required autocomplete="off" maxlength="256" aria-describedby="install-key-help">
        </label>
        <p class="field-help" id="install-key-help">Use a chave definida em <code>INSTALL_SECRET</code> no ambiente de produção.</p>
      <% } %>
      <label>Usuário
        <input name="username" required autocomplete="username" value="<%= values.username || "" %>">
      </label>
      <label>Nome de exibição
        <input name="display_name" required value="<%= values.display_name || "" %>">
      </label>
      <label>E-mail
        <input type="email" name="email" required autocomplete="email" value="<%= values.email || "" %>">
      </label>
      <label>Senha
        <input type="password" name="password" required autocomplete="new-password" maxlength="128" aria-describedby="password-help">
      </label>
      <p class="field-help" id="password-help">Use pelo menos 12 caracteres, incluindo uma letra e um número.</p>
      <label>Confirmar senha
        <input type="password" name="password_confirm" required autocomplete="new-password" maxlength="128">
      </label>
      <button class="primary" type="submit">Criar administrador e instalar</button>
    </form>
  </section>
</main>
<%- include("partials/footer") %>
